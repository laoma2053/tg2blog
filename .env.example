# 复制此文件为 .env 并填写配置，切勿提交 .env 到 Git

# ── Telegram ──────────────────────────────────────────────────────────────────
TG_API_ID=
TG_API_HASH=
SESSION_DIR=/data/session

# ── Typecho ───────────────────────────────────────────────────────────────────
TYPECHO_XMLRPC_ENDPOINT=https://b.zhuiju.us/action/xmlrpc
TYPECHO_USER=
TYPECHO_PASSWORD=
TYPECHO_DEFAULT_CATEGORY=影视资源

# ── CloudFlare ImgBed ─────────────────────────────────────────────────────────
# 是否启用图床上传；false 时跳过上传，直接使用 TMDB 海报（或无图）
IMGBED_ENABLE=true

# 图床部署地址（结尾不加斜杠）
IMGBED_BASE=https://cfimg.zhuiju.us

# 认证方式二选一，填其中一个即可：
# API Token（推荐）：图床后台 → 系统设置 → API Token
IMGBED_API_TOKEN=
# 上传认证码（备用）：图床后台 → 系统设置 → 上传认证码
IMGBED_AUTH_CODE=

# 上传目录（相对路径），留空则上传到根目录；示例：tg-movies / img/2024
IMGBED_UPLOAD_FOLDER=tg-movies

# 上传渠道：telegram（默认）/ cfr2 / s3 / discord / huggingface / webdav
# 需与图床后台已配置的渠道一致
IMGBED_UPLOAD_CHANNEL=telegram

# ── TMDB ──────────────────────────────────────────────────────────────────────
TMDB_ENABLE=true
TMDB_API_TOKEN=
TMDB_LANGUAGE=zh-CN
TMDB_CACHE_DAYS=7
TMDB_SCORE_MIN=60

# ── 飞书通知 ──────────────────────────────────────────────────────────────────
FEISHU_WEBHOOK=
NOTIFY_ON_SUCCESS=false

# ── 运行时 ────────────────────────────────────────────────────────────────────
DB_PATH=/data/db/tg2blog.sqlite
LOG_LEVEL=INFO
CATCHUP_HOURS=24
RETRY_MAX=3
MAX_POSTS_PER_MINUTE=20
