# 复制此文件为 .env 并填写配置，切勿提交 .env 到 Git

# ── Telegram ──────────────────────────────────────────────────────────────────
TG_API_ID=
TG_API_HASH=
# 多个频道用英文逗号分隔，无需空格
TG_CHANNELS=@Oscar_4Kmovies,@channel2,@channel3
SESSION_DIR=/data/session

# ── Typecho ───────────────────────────────────────────────────────────────────
TYPECHO_XMLRPC_ENDPOINT=https://b.zhuiju.us/action/xmlrpc
TYPECHO_USER=
TYPECHO_PASSWORD=
TYPECHO_DEFAULT_CATEGORY=影视资源

# ── CloudFlare ImgBed ─────────────────────────────────────────────────────────
IMGBED_ENABLE=true
IMGBED_BASE=
IMGBED_AUTH_CODE=
IMGBED_API_TOKEN=
IMGBED_UPLOAD_FOLDER=tg-movies
IMGBED_UPLOAD_CHANNEL=telegram

# ── TMDB ──────────────────────────────────────────────────────────────────────
TMDB_ENABLE=true
TMDB_API_TOKEN=
TMDB_LANGUAGE=zh-CN
TMDB_CACHE_DAYS=7
TMDB_SCORE_MIN=60

# ── 网盘导流（全局固定链接，所有文章底部统一展示）──────────────────────────────
NETDISK_QUARK=
NETDISK_BAIDU=
NETDISK_THUNDER=
NETDISK_UC=
MAIN_SITE_URL=https://www.zhuiju.us

# ── 飞书通知 ──────────────────────────────────────────────────────────────────
FEISHU_WEBHOOK=
NOTIFY_ON_SUCCESS=false

# ── 广告过滤（逗号分隔，消息含任一关键词或含 t.me/ 链接则过滤）────────────────
AD_KEYWORDS=推广,广告,赞助,加入会员,限时优惠,点击加入

# ── 运行时 ────────────────────────────────────────────────────────────────────
DB_PATH=/data/db/tg2blog.sqlite
LOG_LEVEL=INFO
CATCHUP_HOURS=24
RETRY_MAX=3
MAX_POSTS_PER_MINUTE=20
