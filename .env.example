# 复制此文件为 .env 并填写配置，切勿将 .env 提交到 Git
# 频道列表、网盘链接、过滤规则等业务配置在 config.yaml 中维护

# ── Telegram ──────────────────────────────────────────────────────────────────
# 登录 https://my.telegram.org → API development tools → 创建应用后获取
TG_API_ID=
TG_API_HASH=

# Telethon session 文件持久化目录（Docker 内固定，无需修改）
SESSION_DIR=/data/session

# ── Typecho ───────────────────────────────────────────────────────────────────
# Typecho XMLRPC 接口地址，固定格式为：https://你的博客域名/action/xmlrpc
# 需在 Typecho 后台 → 设置 → 基本 → 开启 XML-RPC 推送
TYPECHO_XMLRPC_ENDPOINT=

# Typecho 后台登录账号和密码
TYPECHO_USER=
TYPECHO_PASSWORD=

# 默认分类名（需在 Typecho 后台提前创建好）
# 系统会根据内容自动分类：有集数→剧集更新，含电影标签→电影资源，其他→此默认值
TYPECHO_DEFAULT_CATEGORY=影视资源

# ── CloudFlare ImgBed ─────────────────────────────────────────────────────────
# 是否启用图床上传；false 时跳过上传，降级使用 TMDB 海报（或无图发布）
# 参考文档：https://cfbed.sanyue.de/api/upload.html
IMGBED_ENABLE=true

# 图床部署地址（结尾不加斜杠）
IMGBED_BASE=https://cfimg.zhuiju.com

# 认证方式二选一，填其中一个即可：
# API Token（推荐）：图床后台 → 系统设置 → API Token
IMGBED_API_TOKEN=
# 上传认证码（备用）：图床后台 → 系统设置 → 上传认证码
IMGBED_AUTH_CODE=

# 上传目录（相对路径），留空则上传到根目录；示例：tg-movies / img/2024
IMGBED_UPLOAD_FOLDER=tg-movies

# 上传渠道：telegram（默认）/ cfr2 / s3 / discord / huggingface / webdav
# 需与图床后台已配置的渠道名称一致
IMGBED_UPLOAD_CHANNEL=telegram

# ── TMDB ──────────────────────────────────────────────────────────────────────
# 是否启用 TMDB 影片信息补全（海报、评分、演员等）
# false 时只用 TG 消息原文发布，不影响主流程
TMDB_ENABLE=true

# TMDB API Read Access Token（Bearer 格式）
# 申请地址：https://www.themoviedb.org/settings/api（免费，需注册）
TMDB_API_TOKEN=

# 返回语言，zh-CN 为简体中文
TMDB_LANGUAGE=zh-CN

# TMDB 查询结果本地缓存天数，过期后重新请求
TMDB_CACHE_DAYS=7

# TMDB 匹配得分阈值（0-120），低于此分数不采用 TMDB 数据
# 打分规则：标题完全匹配+50 / 年份匹配+30 / 标题包含+20 / 类型正确+20
TMDB_SCORE_MIN=60

# ── 飞书通知 ──────────────────────────────────────────────────────────────────
# 飞书机器人 Webhook 地址，不填则禁用通知
# 创建方式：飞书群 → 设置 → 机器人 → 添加自定义机器人 → 复制 Webhook 地址
FEISHU_WEBHOOK=

# 发布成功是否推送飞书通知（false=不推送，true=推送）
# 发布失败无论此设置如何，始终推送告警
NOTIFY_ON_SUCCESS=false

# ── AI 解析 ───────────────────────────────────────────────────────────────────
# 是否启用 AI 解析（优先于正则，失败时自动降级到正则，不影响主流程）
AI_PARSE_ENABLE=false

# 兼容 OpenAI 接口的服务地址（硅基流动）
AI_PARSE_BASE_URL=https://api.siliconflow.cn/v1

# 服务 API Key
AI_PARSE_API_KEY=

# 模型名称，换模型只需修改此项，无需改代码
# 硅基流动可用模型参考：https://docs.siliconflow.cn/cn/docs/getting-started
# 推荐 Qwen/Qwen3-8B（速度快、成本低，提取任务够用；Qwen3 默认开启思考模式，代码已自动处理）
# 高精度可选 Pro/deepseek-ai/DeepSeek-R1（速度较慢）
AI_PARSE_MODEL=Qwen/Qwen3-8B

# 单次响应最大 token 数。推理模型的思考过程也占用此额度，
# 设得过小会导致正文被截断、返回空 content，日志表现为"AI 解析 JSON 提取失败 | raw="。
# 若日志出现 finish_reason=length，请调高此值。
AI_PARSE_MAX_TOKENS=2048

# 透传给模型接口的额外参数（JSON 对象字符串），主要用于关闭推理模型的思考模式。
# 留空表示不传。推理模型会把 token 花在思考上，本项目只做格式抽取，关掉更快更省。
# 各平台参数名不统一，常见几种写法（需按你所用平台的文档确认）：
#   vLLM / 硅基流动部署的 Qwen3：{"chat_template_kwargs":{"enable_thinking":false}}
#   阿里云百炼 Qwen3：           {"enable_thinking":false}
#   OpenRouter：                 {"reasoning":{"enabled":false}}
#   OpenAI o 系列：              {"reasoning_effort":"minimal"}
# 注意：能否生效取决于服务端是否支持该参数。不支持时通常被静默忽略，
# 少数平台会返回 400——此时日志出现"AI 解析 API 调用失败"，清空本项即可恢复。
AI_PARSE_EXTRA_BODY=

# ── 运行时 ────────────────────────────────────────────────────────────────────
# SQLite 数据库文件路径（Docker 内固定，无需修改）
DB_PATH=/data/db/tg2blog.sqlite

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 服务重启后追溯历史消息的时间窗口（小时）
# 例：24 表示重启后补发最近 24 小时内未处理的 TG 消息
CATCHUP_HOURS=24

# 定期无条件补偿的间隔（分钟），0 表示禁用。
# 断线检测有盲区：30 秒轮询间隙内完成的快速重连、以及连接始终正常但服务端
# 不再推送 update（此时任何基于断线检测的方案都失效）。此项不判断原因，
# 隔一段时间扫一遍已处理消息之后的新消息，漏了就补回来。
# 正常情况下扫描立即返回、开销可忽略；重复消息由消息级去重挡掉，不会重复发文。
PERIODIC_CATCHUP_MINUTES=30

# Typecho 发布失败的最大自动重试次数，超过后标记为 dead 并推送飞书告警
RETRY_MAX=3

# 每分钟最大发布文章数（防止短时间大量发布被 Typecho 限速）
MAX_POSTS_PER_MINUTE=20
